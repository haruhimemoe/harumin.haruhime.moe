# The cluster with harumin's database and the hub's identity database (this user reads identity only).
MONGODB_URI=mongodb://localhost:27017
# Shared with the haruhime.moe hub, to verify its session cookie.
BETTER_AUTH_SECRET=
HUB_URL=https://haruhime.moe
# The bot's service routes and their token (the same token as the bot's HARUMIN_SERVICE_TOKEN).
HARUMIN_SERVICE_URL=http://localhost:8787
HARUMIN_SERVICE_TOKEN=
# The Discord application id, for invite links.
NEXT_PUBLIC_DISCORD_CLIENT_ID=
